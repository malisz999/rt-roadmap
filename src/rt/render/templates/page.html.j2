{% set L %}{% if page.lang %} lang="{{ page.lang }}"{% endif %}{% endset %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="rt {{ page.version }}">
<title{{ L }}>{{ page.title }}</title>
<style>
{{ css }}</style>
</head>
<body class="rt">
{% include "_head.html.j2" %}
{% include "_legend.html.j2" %}
{% if page.summary %}
{% include "_summary.html.j2" %}
{% endif %}
{% include "_scale.html.j2" %}
{% for s in page.sections %}
{% include "_section.html.j2" %}
{% endfor %}
{% if page.warnings %}
{% include "_warnings.html.j2" %}
{% endif %}
<footer class="rt-foot">Generated by rt {{ page.version }}</footer>
</body>
</html>
