{% macro bar(b) %}
<div class="{{ b.classes }}" style="left: {{ b.left }}px; width: {{ b.width }}px; --fill: {{ b.fill }}; --accent: {{ b.accent }}; --ink: {{ b.ink }}" tabindex="0" role="img"{{ L }} title="{{ b.title }}" aria-label="{{ b.aria }}"{% for k, v in b.data %} {{ k }}="{{ v }}"{% endfor %}>
{% if b.locked %}<svg class="rt-bar__lock" width="11" height="13" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M3.2 6.2V4.3a2.8 2.8 0 0 1 5.6 0v1.9" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="1" y="6" width="10" height="8" rx="1.6"/></svg>{% endif %}{% if b.show_name %}<span class="rt-bar__label">{{ b.name }}</span>{% endif %}{% if b.delay %}<span class="rt-bar__pill">{{ b.delay }}</span>{% endif %}{% if b.risk %}<span class="rt-bar__risk">{{ b.risk }}</span>{% endif %}{% if b.chip %}<span class="rt-bar__chip">{{ b.chip }}</span>{% endif %}<span class="rt-tip" role="tooltip" aria-hidden="true">{{ b.title }}</span></div>
{% if b.lead %}
<div class="rt-lead{% if b.lead.cut %} rt-lead--cut{% endif %}" style="left: {{ b.lead.left }}px; width: {{ b.lead.width }}px; --accent: {{ b.accent }}"></div>
{% endif %}
{% endmacro %}
